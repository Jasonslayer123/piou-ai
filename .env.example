# Copy this file to .env for local use, or set these in your host's dashboard.
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key

# Leave empty for local open access. Set a strong code before going public.
PIOU_ACCESS_CODE=

# Optional temporary guest code + when it stops working (ISO 8601 UTC or Unix time).
PIOU_GUEST_CODE=
PIOU_GUEST_UNTIL=

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Rate limits (per client IP / per day)
PIOU_RATE_PER_MINUTE=20
PIOU_RATE_PER_DAY=150
PIOU_GLOBAL_PER_DAY=500
PIOU_LOGIN_PER_MINUTE=10
PIOU_LOGIN_PER_DAY=100

# Set both to 1 on Render/Railway with HTTPS
PIOU_BEHIND_PROXY=0
PIOU_COOKIE_SECURE=0
